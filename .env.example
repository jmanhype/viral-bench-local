# Viral-Bench Local — Docker Compose environment
# Copy to .env and fill in EVERY required value.
# Required secrets are intentionally EMPTY here so that an unchanged
# `.env.example` is rejected by Docker Compose's `:?` substitutions.

# ─── Required ──────────────────────────────────────────
MODELSCOPE_API_KEY=your-modelscope-api-key-here

# ─── Database (required — no default) ─────────────────
POSTGRES_PASSWORD=

# ─── Object Storage (MinIO) (required — no default) ───
MINIO_USER=vbladmin
MINIO_PASSWORD=

# ─── MCP Server auth (required — no default) ──────────
MCP_AUTH_TOKEN=

# ─── Scraper API auth (required to seed corpus) ───────
SCRAPER_API_KEY=

# ─── GPU Server ───────────────────────────────────────
# Points to your 3090 / GPU server running ComfyUI.
# Replace with your LAN GPU host endpoint, e.g. http://gpu-server:8188
COMFYUI_URL=http://gpu-server:8188

# ─── Subagent LLM ────────────────────────────────────
# Used by autonomous_agent for LLM-powered scoring
SUBAGENT_MODEL=qwen3.7-max
SUBAGENT_PROVIDER=modelscope
