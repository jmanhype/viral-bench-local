# Viral-Bench Local — Docker Compose environment
# Copy to .env and fill in your values

# ─── Required ──────────────────────────────────────────
MODELSCOPE_API_KEY=your-modelscope-api-key-here

# ─── Database ──────────────────────────────────────────
POSTGRES_PASSWORD=vbl_secret

# ─── Object Storage (MinIO) ───────────────────────────
MINIO_USER=vbladmin
MINIO_PASSWORD=vbl_secret_123

# ─── MCP Server ───────────────────────────────────────
MCP_AUTH_TOKEN=local-dev-token

# ─── GPU Server ───────────────────────────────────────
# Points to your 3090 / GPU server running ComfyUI
COMFYUI_URL=http://192.168.1.143:8188

# ─── Subagent LLM ────────────────────────────────────
# Used by autonomous_agent for LLM-powered scoring
SUBAGENT_MODEL=qwen3.7-max
SUBAGENT_PROVIDER=modelscope
