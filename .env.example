# Viral-Bench Local — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env.

# ModelScope API key for Qwen3.8-Max VLM analysis
# Get yours: https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=your-modelscope-key-here

# Optional: ComfyUI renderer URL (default: local 3090)
# COMFYUI_URL=http://192.168.1.143:8188

# Optional: MCP auth token
# MCP_AUTH_TOKEN=local-dev-token
